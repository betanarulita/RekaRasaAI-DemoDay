APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=./data/rekarasa.sqlite3
LLM_PROVIDER=groq
GROQ_API_KEY=
MODEL=openai/gpt-oss-20b
IMAGE_PROVIDER=pollinations
OPENAI_API_KEY=
IMAGE_MODEL=flux
# Pollinations.ai — free, no API key needed. Models: flux (best quality), turbo (fast)
#
# IMPORTANT free-tier limits (verified 2026-10-31):
#   - Anonymous tier: ~1 image every 45s per IP (HTTP 402 FREE_LIMIT)
#   - The shared "Classic" endpoint frequently returns HTTP 503 under load;
#     the app retries once automatically before surfacing an error.
#   - Anonymous images carry a small pollinations.ai watermark.
# For a demo, PRE-GENERATE the images you plan to show. For unlimited
# watermark-free images, register a free pollen key at
# https://enter.pollinations.ai and set POLLINATIONS_TOKEN below.
POLLINATIONS_TIMEOUT=120
POLLINATIONS_TOKEN=
# For local ComfyUI instead, set IMAGE_PROVIDER=comfyui and the exact checkpoint filename below.
# NOTE: v1-5-pruned-emaonly.safetensors (SD 1.5) produces poor, unusable product
# photos at 1024px because the model is 512px-native. For quality that matches
# the content pipeline, install an SDXL or FLUX.1-schnell checkpoint instead.
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=
COMFYUI_TIMEOUT=300
# Defaults beside DATABASE_PATH; set to durable storage when deploying.
# IMAGE_STORAGE_PATH=./data/generated-images

# --- SMTP / Email (optional) ---
# When SMTP_HOST is set, password reset tokens are emailed instead of
# printed to the server console, and new accounts receive a verification email.
# Leave blank to keep the console-based reset flow.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@rekarasa.ai
APP_BASE_URL=http://127.0.0.1:8000
# Set to "true" to require email verification before first sign-in.
EMAIL_VERIFICATION_REQUIRED=false

# --- Observability (optional) ---
# SENTRY_DSN enables Sentry error tracking if sentry-sdk is installed.
# LOG_LEVEL controls verbosity: DEBUG, INFO, WARNING, ERROR.
SENTRY_DSN=
LOG_LEVEL=INFO
