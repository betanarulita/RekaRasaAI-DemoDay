APP_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=./data/rekarasa.sqlite3
LLM_PROVIDER=groq
GROQ_API_KEY=
MODEL=openai/gpt-oss-20b
# Default image engine. Cloudflare requires explicit selection; no fallback.
IMAGE_PROVIDER=comfyui
COMFYUI_URL=http://127.0.0.1:8188
# Exact filename from ComfyUI; current workflow uses core SD checkpoint nodes.
# Qwen/FLUX workflows require a separate adapter; they are not drop-in checkpoints.
COMFYUI_CHECKPOINT=v1-5-pruned-emaonly.safetensors
COMFYUI_TIMEOUT=300
# Optional Cloudflare Worker: server-side settings, never put the secret in JS.
CLOUDFLARE_IMAGE_URL=
CLOUDFLARE_IMAGE_API_KEY=
# Set to 1 only after checking the Cloudflare account uses Workers Free.
# This records your confirmation; it cannot prevent a later account plan change.
CLOUDFLARE_WORKERS_FREE_CONFIRMED=0
# Real certificates stay unverified without an official verification process.
# mock_demo is only for clearly labelled synthetic demonstration fixtures.
CERTIFICATE_REGISTRY_MODE=manual
# Defaults beside DATABASE_PATH; set to durable storage when deploying.
# IMAGE_STORAGE_PATH=./data/generated-images

# --- SMTP / Email (optional) ---
# When SMTP_HOST is set, password reset tokens are emailed instead of
# printed to the server console, and new accounts receive a verification email.
# Leave blank to keep the console-based reset flow.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@rekarasa.ai
APP_BASE_URL=http://127.0.0.1:8000
# Set to "true" to require email verification before first sign-in.
EMAIL_VERIFICATION_REQUIRED=false

# --- Observability (optional) ---
# SENTRY_DSN enables Sentry error tracking if sentry-sdk is installed.
# LOG_LEVEL controls verbosity: DEBUG, INFO, WARNING, ERROR.
SENTRY_DSN=
LOG_LEVEL=INFO
